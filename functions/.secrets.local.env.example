# Copy this file to .secrets.local.env (gitignored — see ../.gitignore's
# *.env rule) and fill in real values. Then run:
#
#   npm run secrets:push
#
# from functions/. That reads this file and pushes each value to Firebase
# Functions secrets (Google Secret Manager) via `firebase functions:secrets:set`,
# so you never copy-paste values into the CLI by hand.
#
# Get R2 values from the Cloudflare dashboard: R2 -> Manage API tokens ->
# Create API token, scoped to the shui-videos bucket.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shui-videos
R2_PUBLIC_BASE_URL=https://pub-29f895ffbdcf49779204f67d1a69af9b.r2.dev
