# Shui.xcodeproj is committed (generated by XcodeGen from project.yml —
# see README) so the app opens directly with no XcodeGen install required.
# Re-run `xcodegen generate` and commit the result after editing project.yml.

# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
.DS_Store

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods (not used, but ignore if introduced later)
Pods/

# Secrets — never commit. R2 keys and model API keys belong in Cloud Functions
# secrets; service accounts stay on the machine that runs admin scripts.
*.env
serviceAccountKey*.json
*-service-account.json

# Firebase tooling
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions/node_modules/
functions/lib/
