    ],
    "titleEN": "No Taxation Without Representation",
    "titleVI": "Không Đại Diện Thì Không Đóng Thuế",
    "category": "history_colonial",
    "totalDurationSeconds": 17,
    "narration": [
      {
        "id": "n1",
        "textEN": "Britain kept raising taxes on the colonists.",
        "textVI": "Nước Anh liên tục tăng thuế đối với người thuộc địa.",
        "atSeconds": 0,
        "durationSeconds": 5
      },
      {
        "id": "n2",
        "textEN": "But the colonists had no voice, no vote, in the British Parliament that set those taxes.",
        "textVI": "Nhưng người thuộc địa không có tiếng nói, không có lá phiếu, trong Nghị viện Anh — nơi đặt ra các mức thuế đó.",
        "atSeconds": 5,
        "durationSeconds": 6
      },
      {
        "id": "n3",
        "textEN": "\"No taxation without representation\" became their rallying cry — and one spark of the Revolution.",
        "textVI": "\"Không đại diện thì không đóng thuế\" trở thành khẩu hiệu của họ — một trong những ngòi nổ của cuộc Cách mạng.",
        "atSeconds": 11,
        "durationSeconds": 6
      }
    ],
