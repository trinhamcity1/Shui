    ],
    "titleEN": "Three Legs of One Stool",
    "titleVI": "Ba Chân Của Một Chiếc Ghế",
    "category": "gov_system",
    "totalDurationSeconds": 20,
    "narration": [
      {
        "id": "n1",
        "textEN": "The U.S. government stands on three branches, like a stool with three legs.",
        "textVI": "Chính phủ Mỹ đứng vững nhờ ba nhánh, giống như một chiếc ghế ba chân.",
        "atSeconds": 0,
        "durationSeconds": 6
      },
      {
        "id": "n2",
        "textEN": "Congress makes the laws. The President carries them out. The courts explain them.",
        "textVI": "Quốc hội làm luật. Tổng thống thi hành luật. Tòa án giải thích luật.",
        "atSeconds": 6,
        "durationSeconds": 7
      },
      {
        "id": "n3",
        "textEN": "Each branch can check the others, so no single leg can grow too powerful and tip the stool over.",
        "textVI": "Mỗi nhánh có thể kiểm soát các nhánh còn lại, để không một nhánh nào trở nên quá mạnh và làm lật đổ cả chiếc ghế.",
        "atSeconds": 13,
        "durationSeconds": 7
      }
    ],
    "actions": [
      {
        "id": "a1",
        "type": "titleCard",
        "atSeconds": 0,
        "durationSeconds": 6,
        "textEN": "Three branches",
        "textVI": "Ba nhánh chính quyền",
