        "year": null,
        "items": [
          {
            "textEN": "Legislative — Congress makes laws",
            "textVI": "Lập pháp — Quốc hội làm luật"
          },
          {
            "textEN": "Executive — President enforces laws",
            "textVI": "Hành pháp — Tổng thống thi hành luật"
          },
          {
            "textEN": "Judicial — Courts interpret laws",
            "textVI": "Tư pháp — Tòa án giải thích luật"
