# Copy this file to .env (gitignored — see the root .gitignore's "*.env" rule)
# and fill in real values before running `npm run dev` or `npm run build`.
#
# Where these come from: Firebase console > shui-prod > Project settings >
# General > Your apps > Add app > Web. Registering a Web app is a one-time
# manual console step — nothing in this repo can create it for you. Once
# registered, Firebase shows you a config object with exactly these six
# values.
#
# This is a public client config, not a secret (same status as
# GoogleService-Info.plist for the iOS app) — safe to have in a built
# bundle shipped to a browser. Still gitignored here only so different
# people working on this repo can point at different Firebase projects
# (e.g. a personal test project) without stepping on each other's .env.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
